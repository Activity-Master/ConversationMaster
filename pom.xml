<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>


    <parent>
        <groupId>com.activity-master</groupId>
        <artifactId>activitymaster-group</artifactId>
        <version>3.0.0-SNAPSHOT</version>
        <relativePath>../parent/pom.xml</relativePath>
    </parent>

    <artifactId>conversation-master</artifactId>
    <packaging>jar</packaging>
    <name>Conversation Master</name>


    <properties>
        <project.scm.nameUrl>/Activity-Master/ConversationMaster</project.scm.nameUrl>
    </properties>
	
    <description>FSDM-backed conversations between involved parties</description>
    <dependencies>
        <dependency>
            <groupId>com.activity-master</groupId>
            <artifactId>activity-master</artifactId>
        </dependency>
        <dependency>
            <groupId>com.guicedee.modules.services</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource>
                <directory>../core/src/test/resources</directory>
                <includes>
                    <include>postgres_fsdm.sql</include>
                    <include>postgres_structure.sql</include>
                    <include>META-INF/persistence.xml</include>
                    <include>ehcache.xml</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <argLine>--add-reads org.jboss.logging=org.hibernate.reactive --add-reads org.hibernate.orm.core=com.guicedee.activitymaster.fsdm</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
